# ePub Reader Library - Development Environment Configuration
# This file contains environment-specific settings for development

# Application Environment
ENVIRONMENT=development
DEBUG=true
RUST_LOG=debug

# Database Configuration
DATABASE_URL=sqlite:.epubreader/ebooks/library.db
DATABASE_MAX_CONNECTIONS=5
DATABASE_TIMEOUT=30

# Ollama Configuration
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# Storage Configuration
DATA_DIR=.epubreader
EBOOKS_DIR=ebooks
CACHE_DIR=cache
LOGS_DIR=logs

# UI Configuration
DEFAULT_THEME=dark
DEFAULT_LANGUAGE=en
BOOKS_PER_ROW=4

# Performance Configuration
WORKER_THREADS=2
MAX_MEMORY_MB=512
ENABLE_CACHE=true

# Development Features
HOT_RELOAD=true
MOCK_TRANSLATION=false
VERBOSE_ERRORS=true
ENABLE_DEVTOOLS=true

# Logging Configuration
LOG_LEVEL=debug
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
MAX_LOG_SIZE_MB=10

# Security (relaxed for development)
VALIDATE_EPUB=true
SANITIZE_HTML=true
ALLOW_UNSAFE_OPERATIONS=false

# Translation Configuration
TRANSLATION_ENABLED=true
MAX_CHUNK_SIZE=2000
TRANSLATION_TIMEOUT=120

# Backup Configuration
AUTO_BACKUP=false
BACKUP_FREQUENCY_HOURS=24

# Update Configuration
CHECK_UPDATES=false
AUTO_DOWNLOAD_UPDATES=false